<script id="conversion-config" type="application/json">
{
  "show": {{ market.metafields.custom.show_conversion.value | default: false | json }},
  "currency": {{ market.metafields.custom.target_currency.value | default: "" | json }},
  "rate": {{ market.metafields.custom.exchange_rate.value | default: 0 | json }}
}
</script>

<script>
(function() {
  try {
    const cfgEl = document.getElementById('conversion-config');
    if (!cfgEl) return;
    const cfg = JSON.parse(cfgEl.textContent || "{}");
    const show = !!cfg.show;
    const rate = Number(cfg.rate || 0);
    const currency = cfg.currency || "";

    if (!show || !currency || !rate) return;

    fetch('/cart/update.js', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        attributes: {
          '_show_conversion': String(show),
          '_target_currency': currency,
          '_exchange_rate': String(rate)
        }
      })
    });
  } catch(e) {}
})();
</script>